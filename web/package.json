{
  "name": "class-assistant-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "班级助手 Web 门户（Cloudflare Pages：静态前端 + Functions 后端 + D1）",
  "scripts": {
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy .",
    "test": "node --test backend/test/*.test.js",
    "db:local": "wrangler d1 migrations apply class-assistant-db --local",
    "db:remote": "wrangler d1 migrations apply class-assistant-db --remote",
    "db:migrate": "wrangler d1 migrations apply class-assistant-db --remote"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
