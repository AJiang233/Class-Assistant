<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 活动到点提醒、新通知提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开机后恢复提醒闹钟与同步任务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 后台常驻：前台服务把进程钉住，按分钟级间隔拉新通知（见 sync/BackgroundSyncService）。
         FOREGROUND_SERVICE_* 那两个类型权限是 API 34+ 才有的，更老的系统会忽略。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 免电池优化：Doze 期间系统会挂起网络访问，而**前台服务并不能豁免这一点** ——
         白名单才是唯一确定的豁免，不加的话「手机放着不动」时照样收不到通知。
         个人页「后台通知」那张卡片负责引导用户开（见 MainActivity.HostBridge）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassAssistant"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.ClassAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台常驻：把进程钉在后台，按分钟级间隔轮询新通知（见 sync/BackgroundSyncService）。
             类型写成 dataSync|specialUse，运行时按 SDK 分支传：
               ≥34 传 specialUse（无时长上限，且 targetSdk 升到 35 后仍可从开机广播启动）
               29–33 传 dataSync（那时还没有 specialUse 这个值）
             两个都声明，保证每一支都合法。 -->
        <service
            android:name=".sync.BackgroundSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持续在后台拉取班级通知与活动，好让新通知尽快提醒到人" />
        </service>

        <!-- 深 Doze 兜底：进程内的定时器叫不醒睡着的 CPU，只能靠这个闹钟（见 SyncAlarmReceiver） -->
        <receiver
            android:name=".sync.SyncAlarmReceiver"
            android:exported="false" />

        <!-- 活动到点提醒：由 AlarmManager 触发 -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!-- 开机后恢复同步任务与提醒闹钟 -->
        <receiver
            android:name=".sync.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：今日活动 -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- 桌面小组件：课表 -->
        <receiver
            android:name=".widget.CoursesWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/courses_widget_info" />
        </receiver>

        <!-- 小组件换天 / 系统时间变更 / 覆盖安装：刷新小组件并重排闹钟。
             TIME_SET 与 TIMEZONE_CHANGED 属于系统「隐式广播豁免」名单，清单注册收得到；
             DATE_CHANGED 不在名单里（静态接收器收不到），换天由 Scheduler 的零点闹钟负责。
             exported 保持 true，与上面的 BootReceiver 一致：这三条都是受保护广播，只有系统能发。 -->
        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
