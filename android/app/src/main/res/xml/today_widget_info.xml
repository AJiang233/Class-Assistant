<?xml version="1.0" encoding="utf-8"?>
<!-- 尺寸：长 3 格、高 2 格。框架按 min = 70n − 30 换算格子数（这是 n 格的上限），
     于是 3 格 180dp、2 格 110dp；写大一点就跳成下一格，卡片周围多出一整格空白。
     与课表卡片取同一档：两块都是「标题 + 可滚动的三行卡片列表」，摆在一起才对得齐
     （原先两块都是 4 格 × 3 格，2026-09-14 一起调小）。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_desc" />
