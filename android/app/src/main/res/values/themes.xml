<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ClassAssistant" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 系统栏配色跟随网页底色（浅色），图标用深色 -->
        <item name="android:statusBarColor">@color/window_bg_light</item>
        <item name="android:navigationBarColor">@color/window_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- 桌面小组件里的一行活动 -->
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:textColor">#4b4b55</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 课表小组件：一条课程 = 一个浅色圆角条（FrameLayout 自带底），
         进度条压在上面盖出「上到一半」的效果，文字再压在最上层 -->
    <style name="WidgetCourseRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:background">@drawable/widget_course_row</item>
    </style>

    <!-- minHeight/maxHeight 必须显式写：框架的 progressBarStyleHorizontal 把高度夹在 16dip，
         不覆盖的话进度条只有半条高，跟底下的圆角条对不上 -->
    <style name="WidgetCourseProgress" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:maxHeight">1000dp</item>
        <item name="android:max">100</item>
        <item name="android:progressDrawable">@drawable/widget_course_progress</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="WidgetCourseText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textColor">@color/widget_row_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
