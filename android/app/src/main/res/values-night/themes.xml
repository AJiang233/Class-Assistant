<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色模式：系统栏配色的兜底，网页上报之前照系统深色画。
         网页自选的主题与系统可以相反，覆盖时机见 MainActivity.applySystemBars。
         仅覆盖 Theme.ClassAssistant；WidgetCard 等小组件样式自动回退到 values/。 -->
    <style name="Theme.ClassAssistant" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/window_bg_dark</item>
        <item name="android:navigationBarColor">@color/window_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
