<?xml version="1.0" encoding="utf-8"?>
<!-- 正在上的那条课程：底与普通条一样，上过的部分用更深的靛蓝盖住。
     progressDrawable 的 progress 层必须是 <clip>：进度就是它的 level，
     于是「上到一半」看着就是一半深、一半浅 —— 不用自己去算宽度（RemoteViews 也设不了任意宽度） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_chip" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_chip_fill" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
