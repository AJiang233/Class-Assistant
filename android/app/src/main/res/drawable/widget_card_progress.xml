<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片上「已经过去的那一部分」：底色透明，上过的部分盖一层深色。
     目前只有课表在用（活动卡片不画进度条，见 EventsWidgetService）。

     底色**必须透明**：卡片底现在是每行一个色、画在 card_item_bg 那层 ImageView 上
     （见 widget_card_item.xml），而进度条铺满整张卡 —— 底色不透明就会把每行的底色整块盖掉。
     颜色本身是半透明的（见 colors.xml 的 widget_chip_fill），这里不写实色。

     progress 层必须是 <clip>：进度就是它的 level，
     于是「上到一半」看着就是一半深、一半浅 —— 不用自己去算宽度（RemoteViews 也设不了任意宽度） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_chip_fill" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
