<?xml version="1.0" encoding="utf-8"?>
<!--
  108dp 满幅方图，图形与 web/assets/icons/icon.svg 同源（同一份几何，改一处要两边一起改）。
  坐标换算：设计源的组变换是 translate(256,256) scale(10) translate(-32,-37)，画布 512；
  换到 108 视口后系数为 10 * 108 / 512 = 270/128，即 v 空间坐标 (x, y) → (x-32)*270/128+54。
  描边宽同理：3（v 空间）* 270/128 = 6.328125。

  注意：早先这版把气泡画成实心白、两条横线也是 fillColor="#FFFFFF"，
  白填白等于横线根本渲染不出来（安卓桌面上只看到一个空白气泡）。现改为与设计源一致的
  「描边气泡 + 两条圆头横线」：fillColor 透明，靠 strokeColor / strokeWidth 画线。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#2196F3"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.328125"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M20.25,26.578125 L87.75,26.578125 L87.75,64.546875 L41.34375,64.546875 L20.25,81.421875 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.328125"
        android:strokeLineCap="round"
        android:pathData="M37.125,39.234375 L70.875,39.234375" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.328125"
        android:strokeLineCap="round"
        android:pathData="M37.125,47.671875 L58.21875,47.671875" />
</vector>
