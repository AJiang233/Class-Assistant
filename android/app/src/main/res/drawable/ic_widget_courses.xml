<?xml version="1.0" encoding="utf-8"?>
<!--
  「课表」小组件在系统「添加小组件」列表里的图标。
  与应用图标同族：同样的满幅蓝底渐变、白色图形（今日活动那边是五角星，这里是表格）。
  底板渐变与应用图标完全一致（160°，#4aa3ff → #007aff 55% → #0060cc）。

  108dp 满幅方图，和 ic_launcher.xml 一样交给启动器去裁形状。
  图形是「圆角方框 + 一横一竖两条分隔线」，切成四个格子 —— 表格是课表最直白的画法。

  两条分隔线**故意不写 strokeLineCap**（默认就是 butt）：线头正好收在方框的中心线上，
  与边框严丝合缝；写成 round 的话圆头会从边框外侧冒出来一小截，放大看很脏。
  方框本身用 round join，四个圆角才顺。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30.348"
                android:startY="-11.124"
                android:endX="77.652"
                android:endY="119.124"
                android:type="linear">
                <item android:offset="0" android:color="#FF4AA3FF" />
                <item android:offset="0.55" android:color="#FF007AFF" />
                <item android:offset="1" android:color="#FF0060CC" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineJoin="round"
        android:pathData="M30,26 L78,26 A8,8 0 0 1 86,34 L86,74 A8,8 0 0 1 78,82 L30,82 A8,8 0 0 1 22,74 L22,34 A8,8 0 0 1 30,26 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:pathData="M22,54 L86,54" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:pathData="M54,26 L54,82" />
</vector>
