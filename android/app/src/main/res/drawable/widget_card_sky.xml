<?xml version="1.0" encoding="utf-8"?>
<!-- 「天蓝」卡片的底：与 CARD_BAR_COLORS[1]（#0EA5E9）同色系，掺白到 12% 当底色。
     与 widget_card_sky 一组的还有 indigo / green / amber / rose / violet 五个，样式都一样
     （纯色 + 8dp 圆角），只有色号不同；由 WidgetCard.cardBgRes 按名字选。

     圆角必须留在 drawable 里：卡片底是画在一层 ImageView 上的，用 setBackgroundColor
     只能铺方角纯色（见 WidgetCard.kt 里这段的原委） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E2F4FC" />
    <corners android:radius="8dp" />
</shape>
