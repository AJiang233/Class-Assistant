<?xml version="1.0" encoding="utf-8"?>
<!-- 课表小组件。每条课程是一个「条」：FrameLayout 自带浅靛蓝圆角底，进行中的那条把
     ProgressBar 显示出来盖住已上的部分，文字压在最上层。行数给到 4 —— 一天四五节课是常态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/courses_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/courses_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/courses_widget_title"
        android:textColor="#111114"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <FrameLayout
        android:id="@+id/courses_row_1"
        style="@style/WidgetCourseRow">

        <ProgressBar
            android:id="@+id/courses_row_1_progress"
            style="@style/WidgetCourseProgress" />

        <TextView
            android:id="@+id/courses_row_1_text"
            style="@style/WidgetCourseText" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/courses_row_2"
        style="@style/WidgetCourseRow">

        <ProgressBar
            android:id="@+id/courses_row_2_progress"
            style="@style/WidgetCourseProgress" />

        <TextView
            android:id="@+id/courses_row_2_text"
            style="@style/WidgetCourseText" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/courses_row_3"
        style="@style/WidgetCourseRow">

        <ProgressBar
            android:id="@+id/courses_row_3_progress"
            style="@style/WidgetCourseProgress" />

        <TextView
            android:id="@+id/courses_row_3_text"
            style="@style/WidgetCourseText" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/courses_row_4"
        style="@style/WidgetCourseRow">

        <ProgressBar
            android:id="@+id/courses_row_4_progress"
            style="@style/WidgetCourseProgress" />

        <TextView
            android:id="@+id/courses_row_4_text"
            style="@style/WidgetCourseText" />
    </FrameLayout>

    <TextView
        android:id="@+id/courses_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#8d8d98"
        android:textSize="13sp" />
</LinearLayout>
